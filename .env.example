# ==============================================================================
# EDEXORA Environment Variables Configuration
# Copy this file to .env or configure in your deployment dashboard (e.g. Vercel)
# ==============================================================================

# Server Port (Defaults to 3000 if omitted)
PORT=3000

# Google Apps Script Web App URL for Google Sheets Enquiries
# Obtained after deploying google-apps-script.js as a Web App
GOOGLE_SCRIPT_WEBAPP_URL=

# Official Social Links & Placeholders (to be updated once live)
FACEBOOK_PAGE_URL=
WHATSAPP_CHANNEL_URL=

# Founder / Administrator Email for notifications & ownership
EDEXORA_OWNER_EMAIL=
